# Sätts automatiskt av Vercel när du kopplar en databas till projektet
# (Storage -> Create Database -> Postgres, se README). Behövs inte lokalt –
# saknas den sparas anmälningar i data/waitlist.json istället.
DATABASE_URL=

# Krävs för att kunna logga in på /admin – utan dessa två går det inte
# att logga in alls (medvetet, så inget lösenord ligger i klartext i
# koden/git-historiken). Sätt dem i Vercel (Settings -> Environment
# Variables) eller i en lokal .env.local (gitignorad, skapa själv).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Valfri – slumpas fram en egen lång sträng till denna. Används för att
# signera inloggningssessionen. Saknas den används ett inbyggt
# standardvärde, vilket är okej lokalt men bör bytas i produktion.
ADMIN_SESSION_SECRET=
